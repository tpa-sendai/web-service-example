<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>商品登録</title>
</head>

<body>
  <h1>商品登録</h1>
  <form action="/items/add" method="post">
    <div>
      <label>
        商品名:
        <input type="text" name="name" />
      </label>
    </div>
    <div>
      <label>
        ジャンル名:
